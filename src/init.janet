(import ./clipboard)

(defn run
  `Prints kak initialization script to stdout.
  Called by kak on server startup via:
    evaluate-commands %sh{ ok --api init %val{session} }

  argv[0] is the session name, expanded by kak before the shell runs.
  ($kak_session env var is not set during -E server initialisation.)

  Starts daemons, then collects registration scripts from all modules.`
  [argv]

  # Session passed as argv[0] via %val{session} kak expansion.
  (def session (or (get argv 0) (os/getenv "kak_session")))

  # kak-tree-sitter outputs its kak hook registration script to stdout,
  # which flows through to kak via the %sh{} pipe. Do not redirect it.
  (when session
    (try
      (os/execute ["kak-tree-sitter" "--kakoune"
                   "--init" session
                   "--server" "--daemonize"
                   "--with-highlighting"
                   "--with-text-objects"] :p)
      ([err] (eprintf "ok: kak-tree-sitter failed: %s\n" err))))

  (print (string
    "# ── overk — generated by: ok --api init ─────────────────────────────────────\n"
    "echo -debug 'overk: init sourced'\n"
    "\n"
    "colorscheme default\n"
    "\n"
    "set-option global modelinefmt '{keyword}ok{Default} ── %val{bufname} {{context_info}} {{mode_info}} - %val{client}@{type}%val{session}{Default}'\n"
    "\n"
    (clipboard/register))))
