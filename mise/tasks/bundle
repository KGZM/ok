#!/usr/bin/env bash
# mise description="Assemble the bundle from pre-built components in dist/<target>/"
#
# This task ONLY assembles — it does not build.
# Build upstream components first: make  (or make aarch64, etc.)
# Build ok binary for release:     mise run build-ok
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"

HOST_ARCH="$(uname -m)"
DIST_TARGET="${DIST_TARGET:-${HOST_ARCH}-linux}"
LOCAL="$REPO/dist/$DIST_TARGET"

# Native build → dist/bundle; cross-builds → dist/bundle-<target>
if [ "$DIST_TARGET" = "${HOST_ARCH}-linux" ]; then
    BUNDLE="$REPO/dist/bundle"
else
    BUNDLE="$REPO/dist/bundle-$DIST_TARGET"
fi

# ── preflight ────────────────────────────────────────────────────────────────
for bin in kak kak-lsp kak-tree-sitter ktsctl; do
    if [ ! -f "$LOCAL/bin/$bin" ]; then
        echo "error: $LOCAL/bin/$bin not found — run 'make' first"
        exit 1
    fi
done

echo "==> assembling bundle at $BUNDLE"
rm -rf "$BUNDLE"
mkdir -p "$BUNDLE/bin" "$BUNDLE/share/kak/autoload" "$BUNDLE/share/kak-tree-sitter"

# ── upstream binaries ─────────────────────────────────────────────────────────
# Rename kak → kak-real so the kak wrapper script can be named kak.
cp "$LOCAL/bin/kak"             "$BUNDLE/bin/kak-real"
cp "$LOCAL/bin/kak-lsp"         "$BUNDLE/bin/kak-lsp"
cp "$LOCAL/bin/kak-tree-sitter" "$BUNDLE/bin/kak-tree-sitter"
cp "$LOCAL/bin/ktsctl"          "$BUNDLE/bin/ktsctl"

# ── kak wrapper ───────────────────────────────────────────────────────────────
# Pure environment passthrough. Sets KAKOUNE_RUNTIME, XDG_DATA_HOME, PATH so
# the bundle is self-contained regardless of where it's installed.
# Vanilla kak — no overk wiring here. ok is the overk entrypoint.
cat > "$BUNDLE/bin/kak" << 'WRAPPER'
#!/bin/sh
SELF="$(readlink -f "$0")"
BUNDLE="$(dirname "$(dirname "$SELF")")"
# Save original XDG_RUNTIME_DIR so tools like zellij/tmux can still find
# their own sockets. kak may need a different (or fallback) path for its
# own sockets, but overriding XDG_RUNTIME_DIR globally would break them.
OK_OUTER_XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}"
# kak-tree-sitter requires XDG_RUNTIME_DIR to create its socket and pid file.
# Fall back to a user-specific tmpdir if the session manager hasn't set it.
if [ -z "$XDG_RUNTIME_DIR" ]; then
    _tmpbase=$(dirname "$(mktemp -u)")
    XDG_RUNTIME_DIR="${_tmpbase}/kak-runtime-$(id -u)"
    unset _tmpbase
fi
mkdir -p "$XDG_RUNTIME_DIR"
exec env \
    KAKOUNE_RUNTIME="$BUNDLE/share/kak" \
    KAK_TREE_SITTER_RUNTIME="$BUNDLE/share/kak-tree-sitter" \
    XDG_DATA_HOME="$BUNDLE/share" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    OK_OUTER_XDG_RUNTIME_DIR="$OK_OUTER_XDG_RUNTIME_DIR" \
    PATH="$BUNDLE/bin:$PATH" \
    "$BUNDLE/bin/kak-real" "$@"
WRAPPER
chmod +x "$BUNDLE/bin/kak"

# ── ok ────────────────────────────────────────────────────────────────────────
# Release: copy compiled binary from bin/ok (produced by mise run build-ok).
# Dev:     symlink the repo-root wrapper so kak's PATH="$BUNDLE/bin:$PATH"
#          always finds ok without relying on the user's shell PATH (which
#          sh — used by kak's %sh{} — may not inherit from fish etc.).
if [ -f "$REPO/bin/ok" ]; then
    cp "$REPO/bin/ok" "$BUNDLE/bin/ok"
    chmod +x "$BUNDLE/bin/ok"
else
    ln -sf "$REPO/ok" "$BUNDLE/bin/ok"
fi

# ── vanilla kak runtime ───────────────────────────────────────────────────────
cp "$LOCAL/share/kak/kakrc"     "$BUNDLE/share/kak/kakrc"
# Strip user kakrc sourcing — ok sources ~/.config/ok/kakrc via ok --api init instead.
sed -i '/if \[ -f "\${kak_config}\/kakrc" \]/,/^    fi$/d' "$BUNDLE/share/kak/kakrc"
cp -r "$LOCAL/share/kak/rc"     "$BUNDLE/share/kak/rc"
cp -r "$LOCAL/share/kak/colors" "$BUNDLE/share/kak/colors"
cp -r "$LOCAL/share/kak/doc"    "$BUNDLE/share/kak/doc"
ln -sf ../rc "$BUNDLE/share/kak/autoload/rc"

# kakrc.local — daemon init. $kak_session is set in %sh{} blocks sourced from
# the runtime kakrc (unlike -E where it is not available).
cat > "$BUNDLE/share/kak/kakrc.local" << 'KAKRC_LOCAL'
evaluate-commands %sh{
  kts_dir="${XDG_RUNTIME_DIR}/kak-tree-sitter"
  pid_file="${kts_dir}/pid"
  socket_file="${kts_dir}/socket"
  daemon_stderr="${kts_dir}/stderr.txt"
  grammar_dir="${XDG_DATA_HOME}/kak-tree-sitter/grammars"

  # ── pre-startup diagnostics ──────────────────────────────────────────────
  echo "echo -debug 'kts: XDG_DATA_HOME=${XDG_DATA_HOME}'"
  echo "echo -debug 'kts: XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}'"
  echo "echo -debug 'kts: KAK_TREE_SITTER_RUNTIME=${KAK_TREE_SITTER_RUNTIME}'"
  grammar_count=$(ls "${grammar_dir}"/*.so 2>/dev/null | wc -l | tr -d ' ')
  echo "echo -debug 'kts: grammars: ${grammar_count} .so files'"

  # ── kill stale daemon ────────────────────────────────────────────────────
  if [ -f "${pid_file}" ]; then
    old_pid=$(cat "${pid_file}" 2>/dev/null)
    if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null; then
      kill "${old_pid}" 2>/dev/null
      echo "echo -debug 'kts: killed stale daemon (pid ${old_pid})'"
      sleep 0.3
    else
      echo "echo -debug 'kts: removed stale pid file (pid ${old_pid:-none})'"
    fi
  fi

  # ── start daemon ─────────────────────────────────────────────────────────
  # stdout → kak eval (face init script)
  # stderr → temp file so we can report init-time errors without swallowing them
  init_err="${XDG_RUNTIME_DIR}/kts-init-err.$$"
  kak-tree-sitter --kakoune \
    --init "$kak_session" \
    --server --daemonize \
    --with-highlighting \
    --with-text-objects \
    2>"${init_err}"
  init_exit=$?
  echo "echo -debug 'kts: --init exited ${init_exit}'"
  if [ -s "${init_err}" ]; then
    while IFS= read -r line; do
      safe=$(printf '%s' "${line}" | tr "'" '"')
      echo "echo -debug 'kts init: ${safe}'"
    done < "${init_err}"
  fi
  rm -f "${init_err}"

  # ── verify daemon started ─────────────────────────────────────────────────
  # --daemonize forks; poll briefly for the pid file the child writes.
  i=0
  while [ $i -lt 10 ]; do
    [ -f "${pid_file}" ] && kill -0 "$(cat "${pid_file}" 2>/dev/null)" 2>/dev/null && break
    sleep 0.1
    i=$((i + 1))
  done

  new_pid=$(cat "${pid_file}" 2>/dev/null)
  if [ -n "${new_pid}" ] && kill -0 "${new_pid}" 2>/dev/null; then
    echo "echo -debug 'kts: daemon running (pid ${new_pid})'"
    if [ -S "${socket_file}" ]; then
      echo "echo -debug 'kts: socket ok'"
    else
      echo "echo -debug 'kts: WARNING -- socket not found at ${socket_file}'"
    fi
  else
    echo "echo -debug 'kts: ERROR -- daemon not running after init (exit ${init_exit})'"
  fi

  # ── daemon early stderr ───────────────────────────────────────────────────
  # kts writes its runtime logs to stderr.txt; report anything present at startup.
  if [ -s "${daemon_stderr}" ]; then
    echo "echo -debug 'kts: daemon stderr:'"
    while IFS= read -r line; do
      safe=$(printf '%s' "${line}" | tr "'" '"')
      echo "echo -debug '  ${safe}'"
    done < "${daemon_stderr}"
  fi
}

KAKRC_LOCAL

# kak-lsp rc files vendored into autoload — upstream scripts, not our code.
mkdir -p "$BUNDLE/share/kak/autoload/lsp"
cp "$LOCAL/share/kak-lsp/rc/lsp.kak"    "$BUNDLE/share/kak/autoload/lsp/"
cp "$LOCAL/share/kak-lsp/rc/servers.kak" "$BUNDLE/share/kak/autoload/lsp/"

# ── kak-tree-sitter runtime ───────────────────────────────────────────────────
cp -r "$LOCAL/share/kak-tree-sitter/queries"      "$BUNDLE/share/kak-tree-sitter/queries"
cp -r "$LOCAL/share/kak-tree-sitter/completions"  "$BUNDLE/share/kak-tree-sitter/completions"

# Grammars come from kgzm/grammars — flat .so files, one per language.
# kts loads them via Source::Bundled: $XDG_DATA_HOME/kak-tree-sitter/grammars/{lang}.so
# XDG_DATA_HOME is set to $BUNDLE/share by the kak wrapper, so they land here.
#
# Source priority:
#   Mode 1 (source/dev): grammars/dist/<target>/*.so  — locally compiled
#   Mode 3 (openface) / CI: dist/<target>/share/kak-tree-sitter/grammars/*.so — fetched
mkdir -p "$BUNDLE/share/kak-tree-sitter/grammars"
GRAMMARS_LOCAL="$REPO/grammars/dist/$DIST_TARGET"
GRAMMARS_FETCHED="$LOCAL/share/kak-tree-sitter/grammars"
if ls "$GRAMMARS_LOCAL"/*.so >/dev/null 2>&1; then
    cp "$GRAMMARS_LOCAL"/*.so "$BUNDLE/share/kak-tree-sitter/grammars/"
elif ls "$GRAMMARS_FETCHED"/*.so >/dev/null 2>&1; then
    cp "$GRAMMARS_FETCHED"/*.so "$BUNDLE/share/kak-tree-sitter/grammars/"
else
    echo "warn: no grammars found — run 'make' in grammars/ (Mode 1) or 'mise run fetch' (Mode 3/CI)"
fi

if [ -d "$LOCAL/share/kak-tree-sitter/kts-queries" ]; then
    cp -r "$LOCAL/share/kak-tree-sitter/kts-queries/." "$BUNDLE/share/kak-tree-sitter/queries/"
fi

# ── summary ───────────────────────────────────────────────────────────────────
GRAMMAR_COUNT=0
if [ -d "$BUNDLE/share/kak-tree-sitter/grammars" ]; then
    GRAMMAR_COUNT=$(find "$BUNDLE/share/kak-tree-sitter/grammars" -name "*.so" | wc -l)
fi

echo ""
echo "==> bundle ready at $BUNDLE"
echo ""
echo "    binaries:"
for b in kak-real kak-lsp kak-tree-sitter ktsctl; do
    printf "      %-20s %s\n" "$b" "$(ls -lh "$BUNDLE/bin/$b" | awk '{print $5}')"
done
if [ -f "$REPO/bin/ok" ]; then
    printf "      %-20s %s\n" "ok (compiled)" "$(ls -lh "$BUNDLE/bin/ok" | awk '{print $5}')"
else
    printf "      %-20s %s\n" "ok (dev symlink)" "→ $REPO/ok"
fi
echo ""
echo "    runtime:"
printf "      %-20s %d files\n" "kak/rc (autoload)" "$(find "$BUNDLE/share/kak/rc" -name '*.kak' | wc -l)"
printf "      %-20s %d grammars\n" "tree-sitter" "$GRAMMAR_COUNT"
echo ""
echo "    symlink onto PATH:"
echo "      ln -sf $BUNDLE/bin/kak ~/.local/bin/kak"
echo "      ln -sf ~/packages/kak-emporium/ok ~/.local/bin/ok  # dev"
echo ""
echo "    launch:"
echo "      ok [file]     — overk (tree-sitter + clipboard + bindings)"
echo "      kak [file]    — vanilla kak"
