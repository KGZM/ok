#!/usr/bin/env bash
# mise description="Assemble the bundle from pre-built components in dist/<target>/"
#
# This task ONLY assembles — it does not build.
# Build upstream components first: make  (or make aarch64, etc.)
# Build ok binary for release:     mise run build-ok
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"

HOST_ARCH="$(uname -m)"
DIST_TARGET="${DIST_TARGET:-${HOST_ARCH}-linux}"
LOCAL="$REPO/dist/$DIST_TARGET"

# Native build → dist/bundle; cross-builds → dist/bundle-<target>
if [ "$DIST_TARGET" = "${HOST_ARCH}-linux" ]; then
    BUNDLE="$REPO/dist/bundle"
else
    BUNDLE="$REPO/dist/bundle-$DIST_TARGET"
fi

# ── preflight ────────────────────────────────────────────────────────────────
for bin in kak kak-lsp kak-tree-sitter ktsctl; do
    if [ ! -f "$LOCAL/bin/$bin" ]; then
        echo "error: $LOCAL/bin/$bin not found — run 'make' first"
        exit 1
    fi
done

echo "==> assembling bundle at $BUNDLE"
rm -rf "$BUNDLE"
mkdir -p "$BUNDLE/bin" "$BUNDLE/share/kak/autoload" "$BUNDLE/share/kak-tree-sitter"

# ── upstream binaries ─────────────────────────────────────────────────────────
# Rename kak → kak-real so the kak wrapper script can be named kak.
cp "$LOCAL/bin/kak"             "$BUNDLE/bin/kak-real"
cp "$LOCAL/bin/kak-lsp"         "$BUNDLE/bin/kak-lsp"
cp "$LOCAL/bin/kak-tree-sitter" "$BUNDLE/bin/kak-tree-sitter"
cp "$LOCAL/bin/ktsctl"          "$BUNDLE/bin/ktsctl"

# ── kak wrapper ───────────────────────────────────────────────────────────────
# Pure environment passthrough. Sets KAKOUNE_RUNTIME, XDG_DATA_HOME, PATH so
# the bundle is self-contained regardless of where it's installed.
# Vanilla kak — no overk wiring here. ok is the overk entrypoint.
cat > "$BUNDLE/bin/kak" << 'WRAPPER'
#!/bin/sh
SELF="$(readlink -f "$0")"
BUNDLE="$(dirname "$(dirname "$SELF")")"
mkdir -p "${XDG_RUNTIME_DIR:-/tmp/kak-runtime}"
exec env \
    KAKOUNE_RUNTIME="$BUNDLE/share/kak" \
    KAK_TREE_SITTER_RUNTIME="$BUNDLE/share/kak-tree-sitter" \
    XDG_DATA_HOME="$BUNDLE/share" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/kak-runtime}" \
    PATH="$BUNDLE/bin:$PATH" \
    "$BUNDLE/bin/kak-real" "$@"
WRAPPER
chmod +x "$BUNDLE/bin/kak"

# ── ok (release only) ─────────────────────────────────────────────────────────
# In release: copy compiled binary produced by mise run build-ok.
# In dev: ok is absent from the bundle — kak's PATH fallback finds
#         ~/.local/bin/ok (the repo-root dev shim) instead.
if [ -f "$REPO/bin/ok" ]; then
    cp "$REPO/bin/ok" "$BUNDLE/bin/ok"
    chmod +x "$BUNDLE/bin/ok"
fi

# ── vanilla kak runtime ───────────────────────────────────────────────────────
# Ship the kak runtime exactly as upstream produces it. No kakrc.local.
# ok injects all overk wiring via: kak -E "evaluate-commands %sh{ ok init }"
# Calling bare kak gives vanilla kak — intentional.
cp "$LOCAL/share/kak/kakrc"     "$BUNDLE/share/kak/kakrc"
cp -r "$LOCAL/share/kak/rc"     "$BUNDLE/share/kak/rc"
cp -r "$LOCAL/share/kak/colors" "$BUNDLE/share/kak/colors"
cp -r "$LOCAL/share/kak/doc"    "$BUNDLE/share/kak/doc"
ln -sf ../rc "$BUNDLE/share/kak/autoload/rc"

# kak-lsp rc files vendored into autoload — upstream scripts, not our code.
mkdir -p "$BUNDLE/share/kak/autoload/lsp"
cp "$LOCAL/share/kak-lsp/rc/lsp.kak"    "$BUNDLE/share/kak/autoload/lsp/"
cp "$LOCAL/share/kak-lsp/rc/servers.kak" "$BUNDLE/share/kak/autoload/lsp/"

# ── kak-tree-sitter runtime ───────────────────────────────────────────────────
cp -r "$LOCAL/share/kak-tree-sitter/queries"      "$BUNDLE/share/kak-tree-sitter/queries"
cp -r "$LOCAL/share/kak-tree-sitter/completions"  "$BUNDLE/share/kak-tree-sitter/completions"

if [ -d "$LOCAL/share/kak-tree-sitter/grammars" ]; then
    cp -r "$LOCAL/share/kak-tree-sitter/grammars" "$BUNDLE/share/kak-tree-sitter/"
fi

if [ -d "$LOCAL/share/kak-tree-sitter/kts-queries" ]; then
    cp -r "$LOCAL/share/kak-tree-sitter/kts-queries/." "$BUNDLE/share/kak-tree-sitter/queries/"
fi

# ── summary ───────────────────────────────────────────────────────────────────
GRAMMAR_COUNT=0
if [ -d "$BUNDLE/share/kak-tree-sitter/grammars" ]; then
    GRAMMAR_COUNT=$(ls "$BUNDLE/share/kak-tree-sitter/grammars" | wc -l)
fi

echo ""
echo "==> bundle ready at $BUNDLE"
echo ""
echo "    binaries:"
for b in kak-real kak-lsp kak-tree-sitter ktsctl; do
    printf "      %-20s %s\n" "$b" "$(ls -lh "$BUNDLE/bin/$b" | awk '{print $5}')"
done
if [ -f "$BUNDLE/bin/ok" ]; then
    printf "      %-20s %s\n" "ok (compiled)" "$(ls -lh "$BUNDLE/bin/ok" | awk '{print $5}')"
else
    printf "      %-20s %s\n" "ok" "(dev — resolved via PATH)"
fi
echo ""
echo "    runtime:"
printf "      %-20s %d files\n" "kak/rc (autoload)" "$(find "$BUNDLE/share/kak/rc" -name '*.kak' | wc -l)"
printf "      %-20s %d grammars\n" "tree-sitter" "$GRAMMAR_COUNT"
echo ""
echo "    symlink onto PATH:"
echo "      ln -sf $BUNDLE/bin/kak ~/.local/bin/kak"
echo "      ln -sf ~/packages/kak-emporium/ok ~/.local/bin/ok  # dev"
echo ""
echo "    launch:"
echo "      ok [file]     — overk (tree-sitter + clipboard + bindings)"
echo "      kak [file]    — vanilla kak"
