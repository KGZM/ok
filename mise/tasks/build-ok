#!/usr/bin/env bash
# mise description="Compile ok to a native binary via jpm (release mode)"
#
# Janet's compilation model: janet → C → native binary.
# Requires: janet + jpm, a C compiler (we use zig cc).
#
# jpm is NOT bundled with the janet GitHub release binary.
# Install jpm once (idempotent):
#   git clone --depth=1 https://github.com/janet-lang/jpm /tmp/jpm-src
#   JANET_BASE=$(mise where github:janet-lang/janet)
#   cp -r /tmp/jpm-src/jpm "$JANET_BASE/lib/janet/"
#   cp /tmp/jpm-src/configs/linux_config.janet "$JANET_BASE/lib/janet/jpm/default-config.janet"
#
# Output: bin/ok — copy this into the bundle via mise run bundle.
# Note: jpm's link step will fail (looks for system libjanet); that's fine —
# we only need build/ok.c. Run mise run build-ok to compile for the host arch.
set -euo pipefail
REPO="$(cd "$(dirname "$0")/../.." && pwd)"

JANET_BASE="$(mise where github:janet-lang/janet)"
JANET="$JANET_BASE/bin/janet"
JANET_LIB="$JANET_BASE/lib/janet"
JPM_CLI="$JANET_LIB/jpm/cli.janet"

if [ ! -f "$JPM_CLI" ]; then
    echo "error: jpm not found at $JPM_CLI"
    echo "  Install jpm:"
    echo "    git clone --depth=1 https://github.com/janet-lang/jpm /tmp/jpm-src"
    echo "    cp -r /tmp/jpm-src/jpm \"\$JANET_BASE/lib/janet/\""
    echo "    cp /tmp/jpm-src/configs/linux_config.janet \"\$JANET_BASE/lib/janet/jpm/default-config.janet\""
    exit 1
fi

export CC="zig cc"
export CXX="zig c++"
export JANET_PATH="$JANET_LIB"
export JANET_HEADERPATH="$JANET_BASE/include"

cd "$REPO"
# Generate build/ok.c (link step fails — expected, we relink below)
"$JANET" "$JPM_CLI" build || true

# Compile libjanet.a from the amalgamation source (excludes shell.c/main).
# The prebuilt lib/libjanet.a includes shell.c which has its own main — conflicts.
zig cc -O2 -c \
  -I "$JANET_BASE/include" \
  "$JANET_BASE/src/janet.c" \
  -o /tmp/libjanet-host.o
zig ar rcs /tmp/libjanet-host.a /tmp/libjanet-host.o

zig cc -O2 -s \
  -I "$JANET_BASE/include" \
  build/ok.c \
  /tmp/libjanet-host.a \
  -lm -ldl -lpthread \
  -o bin/ok

echo "==> ok compiled to $REPO/bin/ok"
echo "    run 'mise run bundle' to include it in the bundle"
