#!/usr/bin/env bash
# mise description="Run the ok test suite"
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
PASS=0
FAIL=0

run_test() {
    local file="$1"
    local name
    name="$(basename "$file" .janet)"
    if janet "$file"; then
        PASS=$((PASS + 1))
    else
        echo "FAIL: $name"
        FAIL=$((FAIL + 1))
    fi
}

echo "==> running ok test suite"
echo ""

for f in "$REPO"/test/test-*.janet; do
    run_test "$f"
done

echo ""
if [ "$FAIL" -eq 0 ]; then
    echo "==> all $PASS tests passed"
else
    echo "==> $PASS passed, $FAIL failed"
    exit 1
fi
